# Apache 2.4; required modules: mod_rewrite, mod_headers, mod_mime.
Options -Indexes -MultiViews
DirectoryIndex index.html
DirectorySlash Off
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .json .txt .xml
AddType image/webp .webp
AddType image/avif .avif
AddType video/mp4 .mp4
Header always set X-Robots-Tag "noindex, nofollow, noarchive"
Header always set X-Content-Type-Options "nosniff"
# Keep same-origin Next navigation; forbid native form submission. Leads blocked by client HTTP/empty-endpoint guards.
Header always set Content-Security-Policy "connect-src 'self'; form-action 'none'; object-src 'none'; base-uri 'self'"
<FilesMatch "(?i)(^\.|\.(php[0-9]?|phtml|phar|env|ini|conf|config|sql|bak|log|key|pem)$)">
    Require all denied
</FilesMatch>
<Files ".htaccess">
    Require all denied
</Files>
RewriteEngine On
RewriteBase /
# Restrict this root to the stated virtual host (port optional).
RewriteCond %{HTTP_HOST} !^banger\.ru\.swtest\.ru(?::[0-9]+)?$ [NC]
RewriteRule ^ - [F,END]
# Deny private directories at every depth, including existing host-side data.
RewriteRule (^|/)(private|config|userdata|backend|api|\.git|\.env)(/|$) - [F,END,NC]
RewriteRule \.(php[0-9]?|phtml|phar)(/|$) - [F,END,NC]
# Real files always remain reachable.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [END]
# Preserve explicit article slash alias index.
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^poleznoe/[a-z0-9-]+/$ - [END]
# Resolve exported HTML BEFORE checking colliding asset/route directories.
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [END]
# Root and real indexed directories; DirectorySlash disabled (no unsafe redirects).
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [END]
ErrorDocument 404 /404.html
