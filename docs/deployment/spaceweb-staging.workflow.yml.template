# INACTIVE: outside .github/workflows. Activation requires coordinator review.
name: SpaceWeb staging preparation
on:
  push:
    branches: [spaceweb-staging]
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: spaceweb-staging
  cancel-in-progress: false
env:
  NEXT_PUBLIC_LEADS_ENDPOINT: ''
  NEXT_PUBLIC_LEADS_CONTRACT: '1'
  NEXT_PUBLIC_CONSENT_VERSION: ''
  NEXT_PUBLIC_POLICY_VERSION: ''
  SPACEWEB_BRANCH: spaceweb-staging
  SPACEWEB_HOST: banger.ru.swtest.ru
  SPACEWEB_DOCROOT: /home/b/bangerramb/bangersu/public_html
jobs:
  prepare:
    if: github.ref == 'refs/heads/spaceweb-staging'
    runs-on: ubuntu-latest
    environment: spaceweb-staging
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm
      - name: Guard staging scope
        run: node scripts/spaceweb/safety.mjs guard
      - run: npm ci
      - name: Static root export (single build)
        run: |
          node -e "const c=require('./next.config.js');if(c.output!=='export'||c.basePath)throw Error('Root static export required')"
          npm run build
          npm run check:static
      - name: Prepare isolated noindex artifact
        run: node scripts/spaceweb/prepare.mjs dist staging-artifact
      - run: node scripts/spaceweb/safety.mjs verify staging-artifact
      - uses: actions/upload-artifact@v4
        with:
          name: spaceweb-staging-review
          path: |
            staging-artifact/
            staging-artifact.manifest.json
          include-hidden-files: true
          retention-days: 7
# Deliberately no transfer job. Activation does not authorize an upload.
# Configure environment required reviewers and branch rule spaceweb-staging first.
# Only staging secrets: SPACEWEB_STAGING_SSH_KEY, SPACEWEB_STAGING_KNOWN_HOSTS,
# SPACEWEB_STAGING_SSH_HOST, SPACEWEB_STAGING_SSH_USER, SPACEWEB_STAGING_SSH_PORT.
# SSH server hostname is provider-confirmed separately from the HTTP virtual host.



